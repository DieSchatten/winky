ERGAENZEN_ABSTAND = 0.20   # weiter unter der Schwelle wird nichts übernommen
ERGAENZUNG_MAX = 11        # Vorlagen je Ergänzung
ERGAENZUNGEN_MAX = 3       # benannte Ergänzungen; 30 + 3 * 11 bleibt unter VORLAGEN_MAX
