    umstellen; wer dort etwas eingeschaltet hatte, behält den Komfort."""
    text = lese_konfig()
    gruppen = konfig_wert(text, "freigaben")
    if os.path.exists(ALTE_FREIGABEN_REGEL):
        loeschen(ALTE_FREIGABEN_REGEL)
