def befehl_keepassxc(uid, _name, wahl=None):
    """Polkit-Regel für das Schnellentsperren von KeePassXC ein- oder ausschalten;
    geste-an/geste-aus: zusätzlich das Handzeichen ✌ verlangen (Vorgabe) oder nicht."""
    if wahl == "geste-an":
        setze_konfig("keepassxc_geste", "ja")
        fertig(True)
    if wahl == "geste-aus":
        setze_konfig("keepassxc_geste", "nein")
        fertig(True, hinweis=_("KeePassXC will now open with just your face"))
    if wahl == "an":
        if not konfig_wert(lese_konfig(), "kamera"):
            fertig(False, fehler=_("Set up the camera first"))
        status = lese_status(uid)
        if not os.path.exists(vorlagen_pfad(uid)):
            fertig(False, fehler=_("Record your face first"))
        if status.get("test_ok", 0) < status.get("eingelernt", 0) or not status.get("test_ok"):
            fertig(False, fehler=_("Try out the recognition successfully first"))
        if keepassxc_mit_geste() and not os.path.exists(geste_pfad(uid)):
            fertig(False, fehler=_("Test your face and ✌ first"))
        with open(KEEPASSXC_REGEL_VORLAGE, "rb") as f:
            regel = f.read()
        ordner = os.path.dirname(KEEPASSXC_REGEL)
        if not os.path.isdir(ordner) or os.path.islink(ordner):
            fertig(False, fehler=_("The polkit rules folder is missing"))
        setze_konfig("keepassxc", "ja")
        schreibe_atomar(KEEPASSXC_REGEL, regel, 0o644)
        subprocess.run(["systemctl", "enable", "--now", "winky-polkit.socket"], check=False,
                       capture_output=True)
        fertig(True)
    if wahl == "aus":
        try:
            os.unlink(KEEPASSXC_REGEL)
        except FileNotFoundError:
            pass
        setze_konfig("keepassxc", "nein")
        polkit_zugang_anpassen()
        fertig(True)
    fertig(False, fehler=_("Usage: {usage}").format(usage="keepassxc an|aus|geste-an|geste-aus"))


