    zeilen = [z for z in text.splitlines()
              if not (z.split("#", 1)[0].strip().split("=", 1)[0].strip() == "freigaben")]
    sicherer_ordner("/etc/winky", 0o755)
    schreibe_atomar(KONFIG, ("\n".join(zeilen) + "\n").encode(), 0o644)
    if gruppen.strip():
        setze_konfig("dialoge", "ja")
        schreibe_atomar(DIALOG_SCHALTER, b"Administrator-Dialoge mit Gesicht und Handzeichen\n",
                        0o644)
