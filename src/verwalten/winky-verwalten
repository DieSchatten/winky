               4: "gesperrt", 5: "fehler", 6: "abgelehnt", 7: "ok"}
KONFIG_VORGABE = """\
# Winky: Gesichtsentsperrung am Sperrbildschirm. Wird von winky-verwalten geschrieben.
# schwelle = 0 heißt: noch nicht kalibriert, das Gesicht bleibt aus.
schwelle = 0.65
kamera =
"""


def _uebersetzung():
    """Übersetzungen (Domäne winky) wie in src/app/sprache.py, das hier nicht importierbar ist.
    Läuft als root und liest nichts aus dem Home des Aufrufers: installiert gilt nur
    /usr/share/locale (WINKY_LOCALEDIR nur im Projektordner), und Sprachangaben mit Pfadzeichen
    gelten nicht (pkexec und sudo lassen solche ohnehin nicht durch)."""
    hier = os.path.dirname(os.path.realpath(__file__))
    if hier == "/usr/libexec/winky":
        ordner = "/usr/share/locale"
    else:
        ordner = os.environ.get("WINKY_LOCALEDIR") or os.path.join(
            os.path.dirname(os.path.dirname(hier)), "bau", "locale")
    if any("/" in os.environ.get(v, "") or ".." in os.environ.get(v, "")
           for v in ("LANGUAGE", "LC_ALL", "LC_MESSAGES", "LANG")):
        return gettext.NullTranslations()
    return gettext.translation("winky", ordner, fallback=True)


_ = _uebersetzung().gettext


class Abbruch(Exception):
    """Vorgang beendet; args[0] ist die Art: zeit, abbruch oder dienst."""


def abbruch_text(vorgang, e):
    """Meldung für einen beendeten Vorgang (vorgang: schon übersetzter Name)."""
    vorlagen = {
        "zeit": _("{task} timed out"),
        "abbruch": _("{task} canceled"),
        "dienst": _("{task} failed: the verification service closed the connection. "
                    "Details: journalctl -t winky"),
    }
    return vorlagen.get(e.args[0], vorlagen["dienst"]).format(task=vorgang)


def ausgabe(art, daten):
    sys.stdout.write(f"{art} {json.dumps(daten, ensure_ascii=False)}\n")
    sys.stdout.flush()


def fertig(ok, **daten):
    daten["ok"] = ok
    ausgabe("ERGEBNIS", daten)
    sys.exit(0 if ok else 1)


def aufrufer():
    if os.geteuid() != 0:
        fertig(False, fehler=_("winky-verwalten must run as root (pkexec or sudo)"))
    roh = os.environ.get("PKEXEC_UID") or os.environ.get("SUDO_UID")
    try:
        uid = int(roh)
        eintrag = pwd.getpwuid(uid)
    except (TypeError, ValueError, KeyError):
        fertig(False, fehler=_("Could not tell who is calling"))
    if uid < 1000 or uid == 65534:
        fertig(False, fehler=_("Only for regular user accounts"))
    return uid, eintrag.pw_name


# Dateien

def schreibe_atomar(pfad, daten: bytes, modus, gid=0):
    ordner = os.path.dirname(pfad)
    tmp = os.path.join(ordner, f".{os.path.basename(pfad)}.neu")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW | os.O_CLOEXEC, modus)
    try:
        os.fchown(fd, 0, gid)
        os.fchmod(fd, modus)
        os.write(fd, daten)
        os.fsync(fd)
    finally:
        os.close(fd)
    os.replace(tmp, pfad)


def sicherer_ordner(pfad, modus, gid=0):
    try:
        st = os.lstat(pfad)
        if not stat.S_ISDIR(st.st_mode) or stat.S_ISLNK(st.st_mode):
            fertig(False, fehler=_("{path} is not a folder").format(path=pfad))
    except FileNotFoundError:
        os.mkdir(pfad, modus)
    os.chown(pfad, 0, gid, follow_symlinks=False)
    os.chmod(pfad, modus)


def lese_konfig():
    try:
        with open(KONFIG, encoding="utf-8") as f:
            return f.read()
    except FileNotFoundError:
        return KONFIG_VORGABE


def konfig_wert(text, schluessel):
    for zeile in text.splitlines():
        zeile = zeile.split("#", 1)[0].strip()
        if "=" in zeile:
            k, v = (t.strip() for t in zeile.split("=", 1))
            if k == schluessel:
                return v
    return None


def setze_konfig(schluessel, wert):
    text = lese_konfig()
    zeilen, gesetzt = [], False
    for zeile in text.splitlines():
        kern = zeile.split("#", 1)[0].strip()
        if "=" in kern and kern.split("=", 1)[0].strip() == schluessel:
            zeilen.append(f"{schluessel} = {wert}")
            gesetzt = True
        else:
            zeilen.append(zeile)
    if not gesetzt:
        zeilen.append(f"{schluessel} = {wert}")
    sicherer_ordner("/etc/winky", 0o755)
    schreibe_atomar(KONFIG, ("\n".join(zeilen) + "\n").encode(), 0o644)


def vorlagen_pfad(uid):
    return f"{BASIS}/{uid}/vorlagen.bin"


def geste_pfad(uid):
    """Freigabe für sudo: ✌-Test bestanden (liest der Prüfdienst)."""
    return f"{BASIS}/{uid}/geste-ok"


def loeschen(pfad):
    try:
        os.unlink(pfad)
    except FileNotFoundError:
        pass


def lese_status(uid):
    try:
        with open(f"{STATUS_ORDNER}/{uid}.json", encoding="utf-8") as f:
            daten = json.load(f)
        return daten if isinstance(daten, dict) else {}
    except (FileNotFoundError, ValueError):
        return {}


def schreibe_status(uid, daten):
    sicherer_ordner(STATUS_ORDNER, 0o755)
    schreibe_atomar(f"{STATUS_ORDNER}/{uid}.json", json.dumps(daten).encode(), 0o644)


def aktuelle_schwelle():
    try:
        return float(konfig_wert(lese_konfig(), "schwelle") or 0)
    except ValueError:
        return 0.0


# Prüfdienst

def verbinde(op, uid, dauer):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET)
    try:
        s.connect(SOCKET)
    except OSError:
        fertig(False, fehler=_("The verification service is not running (winky.socket)"))
    cred = s.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i"))
    if struct.unpack("3i", cred)[1] != 0:
        fertig(False, fehler=_("The verification service does not belong to root"))
    s.send(struct.pack("IIII", MAGIC, op, uid, dauer))
    return s


def zeichne_rahmen(rgb, w, h, rahmen, farbe):
    x1, y1, x2, y2 = (max(0, min(int(v), grenze - 1)) for v, grenze in
                      zip(rahmen, (w, h, w, h)))
    for dicke in range(2):
        for y in (y1 + dicke, y2 - dicke):
            a = (y * w + x1) * 3
            rgb[a:a + (x2 - x1 + 1) * 3] = bytes(farbe) * (x2 - x1 + 1)
        for y in range(y1, y2 + 1):
            for x in (x1 + dicke, x2 - dicke):
                a = (y * w + x) * 3
                rgb[a:a + 3] = bytes(farbe)


def strom(s):
    """Leitet Stand und Vorschau an die Oberfläche weiter. Liefert (antwort, vektoren)."""
    rahmen, gut = None, False
    vektoren = None
    fehlertext = None
    letzter = {}
    stdin_offen = True
    while True:
        lesbar = [s] + ([sys.stdin] if stdin_offen else [])
        bereit = select.select(lesbar, [], [], 70)[0]
        if not bereit:
            raise Abbruch("zeit")
        if sys.stdin in bereit:
            if not os.read(sys.stdin.fileno(), 4096):
                stdin_offen = False
                s.close()
                raise Abbruch("abbruch")
        if s not in bereit:
            continue
        try:
            msg = s.recv(262144)
        except OSError:
            msg = b""
        if not msg:
            raise Abbruch("dienst")
        art, inhalt = chr(msg[0]), msg[1:]
        if art == "S":
            st = json.loads(inhalt.decode())
            letzter = st
            rahmen, gut = st.get("rahmen"), st.get("grund") == "ok"
            fehlertext = st.get("fehler") or fehlertext
            ausgabe("STATUS", st)
        elif art == "B" and len(inhalt) >= 4:
            w, h = struct.unpack("HH", inhalt[:4])
            grau = inhalt[4:]
            if len(grau) != w * h:
                continue
            rgb = bytearray(w * h * 3)
            rgb[0::3] = grau
            rgb[1::3] = grau
            rgb[2::3] = grau
            if rahmen:
                zeichne_rahmen(rgb, w, h, rahmen, (60, 220, 90) if gut else (245, 170, 30))
            sys.stdout.buffer.write(f"BILD {w} {h} {len(rgb)}\n".encode() + bytes(rgb))
            sys.stdout.buffer.flush()
        elif art == "V":
            vektoren = inhalt
        elif art == "E" and len(inhalt) == 16:
            _, status, wert, dauer = struct.unpack("IIfI", inhalt)
            antwort = {"status": STATUS_TEXT.get(status, "fehler"), "wert": round(wert, 3),
                       "dauer_ms": dauer}
            if fehlertext:
                antwort["fehler"] = fehlertext
            if "gesicht_erkannt" in letzter:
                antwort["gesicht_erkannt"] = bool(letzter.get("gesicht_erkannt"))
            return antwort, vektoren


def pruefe_vektoren(roh):
    if roh is None or len(roh) < 72:
        fertig(False, fehler=_("No face data received from the verification service"))
    anzahl, dim = struct.unpack("II", roh[:8])
    modell = roh[8:72]
    floats = roh[72:]
    if modell != MODELL_SHA or dim != MODELL_DIM or not 8 <= anzahl <= 64 or \
            len(floats) != anzahl * dim * 4:
        fertig(False, fehler=_("The face data from the verification service is invalid"))
    werte = struct.unpack(f"{anzahl * dim}f", floats)
    for i in range(anzahl):
        v = werte[i * dim:(i + 1) * dim]
        if not all(math.isfinite(x) for x in v) or abs(math.sqrt(sum(x * x for x in v)) - 1) > 1e-3:
            fertig(False, fehler=_("The face data from the verification service is invalid"))
    return anzahl, dim, floats


# Befehle

def befehl_einlernen(uid, _name):
    s = verbinde(OP_EINLERNEN, uid, 25)
    try:
        antwort, vektoren = strom(s)
    except Abbruch as e:
        fertig(False, fehler=abbruch_text(_("Recording your face"), e), abgebrochen=True)
    if antwort["status"] != "ok":
        hinweis = {"kein_gesicht": _("Too few usable images. Please look straight into the "
                                     "camera and move your head only slightly.")}
        fertig(False, fehler=hinweis.get(antwort["status"]) or antwort.get("fehler") or
               _("Recording your face failed. Details: journalctl -t winky"))
    anzahl, dim, floats = pruefe_vektoren(vektoren)
    gid = grp.getgrnam(GRUPPE).gr_gid
    sicherer_ordner(BASIS, 0o755)
    sicherer_ordner(f"{BASIS}/{uid}", 0o750, gid)
    kopf = b"WNKV" + struct.pack("III", 1, dim, anzahl) + MODELL_SHA + struct.pack("q", int(time.time()))
    schreibe_atomar(vorlagen_pfad(uid), kopf + floats, 0o640, gid)
    loeschen(geste_pfad(uid))  # neue Vorlagen: ✌-Test bitte neu
    schreibe_status(uid, {"vorlagen": anzahl, "vorlagen_basis": anzahl,
                          "eingelernt": int(time.time())})
    fertig(True, vorlagen=anzahl)


def lese_vorlagen(uid):
    """Gespeicherte Vorlagen als Liste von Vektoren; None, wenn fehlend oder ungültig."""
    try:
        with open(vorlagen_pfad(uid), "rb") as f:
            roh = f.read(88 + VORLAGEN_MAX * MODELL_DIM * 4 + 1)
    except OSError:
        return None
    if len(roh) < 88 or roh[:4] != b"WNKV":
        return None
    version, dim, anzahl = struct.unpack("III", roh[4:16])
    if version != 1 or dim != MODELL_DIM or roh[16:80] != MODELL_SHA or \
            not 1 <= anzahl <= VORLAGEN_MAX or len(roh) != 88 + anzahl * dim * 4:
        return None
    werte = struct.unpack(f"{anzahl * dim}f", roh[88:])
    return [list(werte[i * dim:(i + 1) * dim]) for i in range(anzahl)]


def aehnlichkeit(merkmal, vorlagen):
    """Wie der Prüfdienst (bewerte): Mittel der drei besten Übereinstimmungen."""
    werte = sorted((sum(a * b for a, b in zip(merkmal, v)) for v in vorlagen), reverse=True)
    besten = werte[:3]
    return sum(besten) / len(besten)


def gleichmaessig(liste, n):
    """n Einträge gleichmäßig verteilt (wie die Auswahl beim Einlernen)."""
    if n >= len(liste):
        return list(liste)
    if n <= 0:
        return []
    if n == 1:
        return [liste[0]]
    return [liste[i * (len(liste) - 1) // (n - 1)] for i in range(n)]


def ergaenzung_auswaehlen(alt, neu, schwelle):
    """Was aus einer Aufnahme dazukommt: (Auswahl, Belege). Auswahl None, wenn die Aufnahme das
    eingelernte Gesicht nicht oft genug erkannt hat; sonst höchstens ERGAENZUNG_MAX Bilder, die
    höchstens ERGAENZEN_ABSTAND unter der Schwelle liegen, also kein fremdes Gesicht."""
    werte = [aehnlichkeit(v, alt) for v in neu]
    belege = sum(w >= schwelle for w in werte)
    if belege < ERGAENZEN_BELEGE:
        return None, belege
    passend = [v for v, w in zip(neu, werte) if w >= schwelle - ERGAENZEN_ABSTAND]
    return gleichmaessig(passend, ERGAENZUNG_MAX), belege


def gruppen(status, anzahl):
    """Einlernen-Basis und benannte Ergänzungen aus dem Status. Passt die Liste nicht zur Datei
    (ältere Stände), gilt alles nach der Basis als eine Ergänzung ohne Namen."""
    basis = max(1, min(status.get("vorlagen_basis") or EINLERNEN_MAX, anzahl, EINLERNEN_MAX))
    liste = [e for e in status.get("ergaenzungen") or [] if isinstance(e, dict)]
    try:
        stimmt = sum(int(e.get("anzahl", 0)) for e in liste) == anzahl - basis and \
            all(int(e.get("anzahl", 0)) > 0 for e in liste)
    except (TypeError, ValueError):
        stimmt = False
    if not stimmt:
        rest = anzahl - basis
        liste = [{"id": 1, "name": "", "anzahl": rest, "zeit": int(status.get("ergaenzt") or 0)}] \
            if rest > 0 else []
    return basis, [dict(e) for e in liste]


def zusammensetzen(alt, basis, liste, ohne_id=None):
    """Basis und Ergänzungen, ohne die Gruppe ohne_id: (Vorlagen, verbleibende Liste)."""
    vorlagen, bleibt, pos = list(alt[:basis]), [], basis
    for e in liste:
        n = int(e["anzahl"])
        if e.get("id") != ohne_id:
            vorlagen += alt[pos:pos + n]
            bleibt.append(e)
        pos += n
    return vorlagen, bleibt


def ergaenzung_name(roh):
    name = " ".join("".join(z for z in roh if z.isprintable()).split())[:40]
    if not name:
        fertig(False, fehler=_("Give the addition a name, for example “With glasses”"))
    return name


def schreibe_vorlagen(uid, vorlagen):
    gid = grp.getgrnam(GRUPPE).gr_gid
    daten = b"".join(struct.pack(f"{MODELL_DIM}f", *v) for v in vorlagen)
    kopf = (b"WNKV" + struct.pack("III", 1, MODELL_DIM, len(vorlagen)) + MODELL_SHA +
            struct.pack("q", int(time.time())))
    schreibe_atomar(vorlagen_pfad(uid), kopf + daten, 0o640, gid)


def befehl_ergaenzen(uid, _name, roh_name=""):
    """Benannte Ergänzung aufnehmen; eine gleichnamige wird ersetzt, höchstens drei."""
    name = ergaenzung_name(roh_name)
    alt = lese_vorlagen(uid)
    if alt is None:
        fertig(False, fehler=_("Record your own face first"))
    schwelle = aktuelle_schwelle()
    if schwelle <= 0:
        fertig(False, fehler=_("No strictness set (Advanced)."))
    status = lese_status(uid)
    basis, liste = gruppen(status, len(alt))
    gleich = next((e for e in liste if e.get("name", "").casefold() == name.casefold()), None)
    if gleich is None and len(liste) >= ERGAENZUNGEN_MAX:
        fertig(False, fehler=_("There are already three additions. Delete one first, or use the "
                               "name of one you want to replace."))
    s = verbinde(OP_EINLERNEN, uid, 25)
    try:
        antwort, vektoren = strom(s)
    except Abbruch as e:
        fertig(False, fehler=abbruch_text(_("Adding to your face"), e), abgebrochen=True)
    if antwort["status"] != "ok":
        hinweis = {"kein_gesicht": _("Too few usable images. Please look straight into the "
                                     "camera and move your head only slightly.")}
        fertig(False, fehler=hinweis.get(antwort["status"]) or antwort.get("fehler") or
               _("Recording your face failed. Details: journalctl -t winky"))
    anzahl, dim, floats = pruefe_vektoren(vektoren)
    werte = struct.unpack(f"{anzahl * dim}f", floats)
    neu = [list(werte[i * dim:(i + 1) * dim]) for i in range(anzahl)]
    auswahl, _belege = ergaenzung_auswaehlen(alt, neu, schwelle)
    if auswahl is None:
        fertig(False, nicht_erkannt=True, fehler=_(
            "Winky didn’t recognize you clearly enough in this recording, so nothing was added. "
            "Start the way Winky already recognizes you, for example without glasses, and only "
            "then put them on. If Winky hardly recognizes you at all, record your face again."))
    if not auswahl:
        fertig(False, fehler=_("Nothing in this recording was close enough to your face. "
                               "Nothing was added."))
    vorlagen, bleibt = zusammensetzen(alt, basis, liste, gleich["id"] if gleich else None)
    jetzt = int(time.time())
    neue_id = max([int(e.get("id", 0)) for e in liste] + [jetzt - 1]) + 1
    bleibt.append({"id": neue_id, "name": name, "anzahl": len(auswahl), "zeit": jetzt})
    schreibe_vorlagen(uid, vorlagen + auswahl)
    status.update(vorlagen=len(vorlagen) + len(auswahl), vorlagen_basis=basis,
                  ergaenzungen=bleibt, ergaenzt=jetzt)
    schreibe_status(uid, status)
    fertig(True, vorlagen=len(vorlagen) + len(auswahl), uebernommen=len(auswahl),
           ersetzt=gleich is not None)


def befehl_ergaenzung_entfernen(uid, _name, kennung=""):
    try:
        ziel = int(kennung)
    except ValueError:
        fertig(False, fehler=_("Usage: {usage}").format(usage="ergaenzung-entfernen ID"))
    alt = lese_vorlagen(uid)
    if alt is None:
        fertig(False, fehler=_("Record your own face first"))
    status = lese_status(uid)
    basis, liste = gruppen(status, len(alt))
    if not any(e.get("id") == ziel for e in liste):
        fertig(False, fehler=_("This addition no longer exists"))
    vorlagen, bleibt = zusammensetzen(alt, basis, liste, ziel)
    schreibe_vorlagen(uid, vorlagen)
    status.update(vorlagen=len(vorlagen), vorlagen_basis=basis, ergaenzungen=bleibt)
    schreibe_status(uid, status)
    fertig(True, vorlagen=len(vorlagen))


def befehl_testen(uid, _name):
    s = verbinde(OP_TESTEN, uid, 15)
    try:
        antwort = strom(s)[0]
    except Abbruch as e:
        fertig(False, fehler=abbruch_text(_("Test"), e), abgebrochen=True)
    if antwort["status"] == "fehler" and not antwort.get("fehler"):
        antwort["fehler"] = _("Test failed. Details: journalctl -t winky")
    if antwort["status"] == "treffer":
        status = lese_status(uid)
        status.update(test_ok=int(time.time()), test_wert=antwort["wert"])
        schreibe_status(uid, status)
    fertig(antwort["status"] == "treffer", **antwort)


def countdown(sekunden):
    """Zeit nach der Passworteingabe, um aus dem Bild zu gehen. Abbruch über die
    geschlossene Eingabe wie beim Kamerastrom."""
    for rest in range(sekunden, 0, -1):
        ausgabe("STATUS", {"modus": "countdown", "rest": rest})
        bereit = select.select([sys.stdin], [], [], 1)[0]
        if bereit and not os.read(sys.stdin.fileno(), 4096):
            fertig(False, fehler=abbruch_text(_("Second-person check"), Abbruch("abbruch")),
                   abgebrochen=True)


def befehl_gegenprobe(uid, _name):
    """Eine andere Person darf nicht erkannt werden und soll deutlich unter der Schwelle bleiben."""
    if not os.path.exists(vorlagen_pfad(uid)):
        fertig(False, fehler=_("Record your own face first"))
    countdown(GEGENPROBE_COUNTDOWN)
    s = verbinde(OP_TESTEN, uid, 10)
    try:
        antwort = strom(s)[0]
    except Abbruch as e:
        fertig(False, fehler=abbruch_text(_("Second-person check"), e), abgebrochen=True)
    if antwort["status"] in ("kein_gesicht",):
        fertig(False, fehler=_("No face seen. The other person should look straight into the "
                               "camera."), **antwort)
    if antwort["status"] not in ("treffer", "kein_treffer"):
        fertig(False, fehler=antwort.get("fehler") or _("Check with a second person failed"),
               **antwort)
    schwelle = aktuelle_schwelle()
    wert = antwort["wert"]
    erkannt = antwort["status"] == "treffer"
    zu_nah = wert >= schwelle - GEGENPROBE_ABSTAND
    status = lese_status(uid)
    eigen = status.get("test_wert") or 0
    if (erkannt or zu_nah) and eigen and wert >= eigen - 0.10:
        # So ähnlich wie das eigene Gesicht: meist war man noch im Bild. Nicht speichern.
        fertig(False, wie_eigen=True, fehler=_(
            "Winky saw a face as similar as your own. Were you still in the picture? Then check "
            "again and step away during the countdown. If not, Winky can’t tell this person "
            "apart from you; better use only your password."), **antwort)
    status.update(gegenprobe_zeit=int(time.time()), gegenprobe_wert=wert,
                  gegenprobe_ok=not erkannt and not zu_nah)
    schreibe_status(uid, status)
    if erkannt:
        fertig(False, fehler=_("The other person was recognized as you. The threshold needs "
                               "to be higher."), **antwort)
    if zu_nah:
        fertig(False, fehler=_("The other person reached {value}, close to the threshold of "
                               "{threshold}. Please raise the threshold.").format(
                                   value=f"{wert:.2f}", threshold=f"{schwelle:.2f}"), **antwort)
    fertig(True, **antwort)


def befehl_geste_testen(uid, _name):
    """Gesicht und ✌ wie bei sudo, aber mit Vorschau und mehr Zeit. Gelingt es, gibt das
    die sudo-Bestätigung für diese Person frei (Datei geste-ok)."""
    if not os.path.exists(vorlagen_pfad(uid)):
        fertig(False, fehler=_("Record your own face first"))
    s = verbinde(OP_GESTE_TESTEN, uid, 12)
    try:
        antwort = strom(s)[0]
    except Abbruch as e:
        fertig(False, fehler=abbruch_text(_("Test"), e), abgebrochen=True)
    if antwort["status"] == "treffer":
        gid = grp.getgrnam(GRUPPE).gr_gid
        jetzt = int(time.time())
        schreibe_atomar(geste_pfad(uid), f"{jetzt}\n".encode(), 0o640, gid)
        status = lese_status(uid)
        status.update(geste_ok=jetzt)
        schreibe_status(uid, status)
        fertig(True, **antwort)
    if antwort["status"] == "kein_treffer" and antwort.get("gesicht_erkannt"):
        antwort["fehler"] = _("Your face was recognized, but the ✌ sign wasn't. Show your "
                              "index and middle finger as a V, palm facing the camera, next to "
                              "your face.")
    elif antwort["status"] in ("kein_treffer", "kein_gesicht") and not antwort.get("fehler"):
        antwort["fehler"] = _("Your face was not recognized. Please look straight into the "
                              "camera.")
    elif not antwort.get("fehler"):
        antwort["fehler"] = _("Test failed. Details: journalctl -t winky")
    fertig(False, **antwort)


def kamerasuche(uid):
    s = verbinde(OP_KAMERAS, uid, 0)
    liste = None
    while True:
        bereit = select.select([s], [], [], 30)[0]
        if not bereit:
            fertig(False, fehler=_("The camera search is taking too long"))
        msg = s.recv(262144)
        if not msg:
            break
        if chr(msg[0]) == "S":
            try:
                liste = json.loads(msg[1:].decode()).get("kameras")
            except ValueError:
                pass
        elif chr(msg[0]) == "E":
            break
    if not isinstance(liste, list):
        fertig(False, fehler=_("The camera search failed"))
    return [k for k in liste if isinstance(k, dict) and isinstance(k.get("pfad"), str)]


def beste_kamera(liste):
    nutzbar = [k for k in liste if not k.get("fehler")]
    nutzbar.sort(key=lambda k: (k.get("hell", 0) >= 10, bool(k.get("blinkt")), k.get("hell", 0)),
                 reverse=True)
    return nutzbar[0] if nutzbar else None


def befehl_kameras(uid, _name):
    liste = kamerasuche(uid)
    beste = beste_kamera(liste)
    fertig(True, kameras=liste, empfohlen=beste["pfad"] if beste else None)


def befehl_kamera(uid, _name, wahl=None):
    liste = kamerasuche(uid)
    if wahl == "auto":
        kamera = beste_kamera(liste)
    else:
        kamera = next((k for k in liste if wahl in (k.get("pfad"), k.get("geraet"))), None)
    if kamera is None:
        fertig(False, fehler=_("No suitable IR camera found. Winky looks for cameras with a "
                               "grayscale image (IR)."), kameras=liste)
    if kamera.get("fehler"):
        fertig(False, fehler=_("The camera can't be opened: {error}").format(
            error=kamera["fehler"]))
    pfad = kamera["pfad"]
    if not pfad.startswith("/dev/") or ".." in pfad or any(c in pfad for c in "\n\r#= "):
        fertig(False, fehler=_("Invalid camera path"))
    setze_konfig("kamera", pfad)
    setze_konfig("blinkpruefung", "ja" if kamera.get("blinkt") else "nein")
    hinweis = None
    if kamera.get("hell", 0) < 10:
        hinweis = _("The IR image stays dark. On some laptops the IR emitter has to be "
                    "switched on first (for example with linux-enable-ir-emitter).")
    fertig(True, kamera=kamera, hinweis=hinweis)


