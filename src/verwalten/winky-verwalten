    fertig(True, benutzer=name, eingelernt=os.path.exists(vorlagen_pfad(uid)),
           vorlagen=status.get("vorlagen"), schwelle=konfig_wert(lese_konfig(), "schwelle"),
           kamera=konfig_wert(lese_konfig(), "kamera"), test_ok=status.get("test_ok"),
           keepassxc=os.path.exists(KEEPASSXC_REGEL), keepassxc_geste=keepassxc_mit_geste(),
           sudo=os.path.exists(SUDO_SCHALTER), dialoge=os.path.exists(DIALOG_SCHALTER),
           anmeldung=os.path.exists(ANMELDUNG_SCHALTER),
           entsperren_geste=os.path.exists(ENTSPERREN_SCHALTER),
           geste_zeit=int(konfig_wert(lese_konfig(), "sudo_ms") or 8000) // 1000,
           schluesselbund=os.path.exists(schluesselbund_pfad(uid)), secure_boot=secure_boot(),
           geste_ok=os.path.exists(geste_pfad(uid)),
           gegenprobe_ok=status.get("gegenprobe_ok"),
           aktiv=pam_aktiv(), pausiert=os.path.exists(NOTSCHALTER), dienst=socket_aktiv)


BEFEHLE = {
    "status": befehl_status, "einlernen": befehl_einlernen, "ergaenzen": None,
    "ergaenzung-entfernen": None,
    "testen": befehl_testen,
    "gegenprobe": befehl_gegenprobe, "kameras": befehl_kameras, "kamera": befehl_kamera,
    "entfernen": befehl_entfernen, "schwelle": befehl_schwelle,
    "aktivieren": befehl_aktivieren, "deaktivieren": befehl_deaktivieren,
    "pausieren": befehl_pausieren, "fortsetzen": befehl_fortsetzen,
    "keepassxc": befehl_keepassxc, "geste-testen": befehl_geste_testen, "sudo": befehl_sudo,
    "dialoge": None, "anmeldung": None, "geste-zeit": None, "entsperren-geste": None,
    "schluesselbund": None,
}


def main(argv):
    os.umask(0o022)
    # Nach Paket-Updates (postinst, als root, auch unter sudo apt): alte Einstellungen umstellen
    if argv[1:] == ["migrieren"] and os.getuid() == 0:
        migrieren()
        sys.exit(0)
    mit_wert = {"schwelle", "kamera", "keepassxc", "sudo", "dialoge",
                "anmeldung", "geste-zeit", "schluesselbund", "entsperren-geste", "ergaenzen",
                "ergaenzung-entfernen"}
    if len(argv) < 2 or argv[1] not in BEFEHLE or (argv[1] in mit_wert) != (len(argv) == 3) \
            or len(argv) > 3:
        fertig(False, fehler=_("Usage: winky-verwalten {commands} [VALUE]").format(
            commands="|".join(BEFEHLE)))
    if os.path.basename(argv[0]) == "winky-gesicht" and argv[1] not in GESICHT_BEFEHLE:
        fertig(False, fehler=_("This needs the administrator password (winky-verwalten)"))
    uid, name = aufrufer()
    if argv[1] == "schwelle":
        befehl_schwelle(uid, name, argv[2])
    if argv[1] == "kamera":
        befehl_kamera(uid, name, argv[2])
    if argv[1] == "keepassxc":
        befehl_keepassxc(uid, name, argv[2])
    if argv[1] == "sudo":
        befehl_sudo(uid, name, argv[2])
    if argv[1] == "anmeldung":
        befehl_anmeldung(uid, name, argv[2])
    if argv[1] == "geste-zeit":
        befehl_geste_zeit(uid, name, argv[2])
    if argv[1] == "schluesselbund":
        befehl_schluesselbund(uid, name, argv[2])
    if argv[1] == "dialoge":
        befehl_dialoge(uid, name, argv[2])
    if argv[1] == "entsperren-geste":
        befehl_entsperren_geste(uid, name, argv[2])
    if argv[1] == "ergaenzen":
        befehl_ergaenzen(uid, name, argv[2])
    if argv[1] == "ergaenzung-entfernen":
        befehl_ergaenzung_entfernen(uid, name, argv[2])
    BEFEHLE[argv[1]](uid, name)


if __name__ == "__main__":
    main(sys.argv)
