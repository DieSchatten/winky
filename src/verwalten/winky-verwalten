def schluesselbund_pfad(uid):
    return f"{BASIS}/{uid}/schluesselbund.cred"


def secure_boot():
    """True/False aus der EFI-Variable SecureBoot, None ohne EFI."""
    try:
        with open("/sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-e2b6eac5b2ae",
                  "rb") as f:
            return f.read()[-1:] == b"\x01"
    except OSError:
        return None


def befehl_schluesselbund(uid, name, wahl=None):
    """Anmeldepasswort im TPM versiegeln (host+tpm2, PCR 7), damit die Erstanmeldung per
    Gesicht auch den Schlüsselbund öffnet. Das Passwort kommt als erste Zeile über stdin und
    wird vorher mit unix_chkpwd geprüft; es landet nie in Argumenten, Umgebung oder Protokoll."""
    if wahl == "aus":
        loeschen(schluesselbund_pfad(uid))
        status = lese_status(uid)
        status.pop("schluesselbund", None)
        status.pop("schluesselbund_veraltet", None)
        schreibe_status(uid, status)
        fertig(True)
    if wahl != "an":
        fertig(False, fehler=_("Usage: {usage}").format(usage="schluesselbund an|aus"))
    passwort = sys.stdin.buffer.readline(1100).rstrip(b"\n")
    if not os.path.exists(ANMELDUNG_SCHALTER):
        fertig(False, fehler=_("Turn on login after startup first"))
    if not passwort or len(passwort) > 1024:
        fertig(False, fehler=_("No password given"))
    if subprocess.run(["systemd-creds", "has-tpm2"], capture_output=True).returncode != 0:
        fertig(False, fehler=_("No usable TPM chip found on this computer"))
    pruefung = subprocess.run(["/usr/sbin/unix_chkpwd", name, "nullok"], input=passwort + b"\0",
                              capture_output=True)
    if pruefung.returncode != 0:
        fertig(False, fehler=_("That is not your login password"))
    ordner = f"{BASIS}/{uid}"
    sicherer_ordner(ordner, 0o750, grp.getgrnam(GRUPPE).gr_gid)
    neu = schluesselbund_pfad(uid) + ".neu"
    loeschen(neu)
    alt = os.umask(0o077)
    try:
        r = subprocess.run(["systemd-creds", "encrypt", "--with-key=host+tpm2", "--tpm2-pcrs=7",
                            f"--name=winky-schluesselbund-{uid}", "-", neu], input=passwort,
                           capture_output=True)
    finally:
        os.umask(alt)
    if r.returncode != 0:
        loeschen(neu)
        fertig(False, fehler=_("Sealing in the TPM chip failed"),
               ausgabe=r.stderr.decode(errors="replace")[-300:])
    os.chmod(neu, 0o600)
    os.rename(neu, schluesselbund_pfad(uid))
    status = lese_status(uid)
    status["schluesselbund"] = int(time.time())
    status.pop("schluesselbund_veraltet", None)
    schreibe_status(uid, status)
    fertig(True, secure_boot=secure_boot())


