def _uebersetzung():
    """Übersetzungen (Domäne winky) wie in src/app/sprache.py, das hier nicht importierbar ist.
    Läuft als root und liest nichts aus dem Home des Aufrufers: installiert gilt nur
    /usr/share/locale (WINKY_LOCALEDIR nur im Projektordner), und Sprachangaben mit Pfadzeichen
    gelten nicht (pkexec und sudo lassen solche ohnehin nicht durch)."""
    hier = os.path.dirname(os.path.realpath(__file__))
    if hier == "/usr/libexec/winky":
        ordner = "/usr/share/locale"
    else:
        ordner = os.environ.get("WINKY_LOCALEDIR") or os.path.join(
            os.path.dirname(os.path.dirname(hier)), "bau", "locale")
    if any("/" in os.environ.get(v, "") or ".." in os.environ.get(v, "")
           for v in ("LANGUAGE", "LC_ALL", "LC_MESSAGES", "LANG")):
        return gettext.NullTranslations()
    return gettext.translation("winky", ordner, fallback=True)


_ = _uebersetzung().gettext


class Abbruch(Exception):
    """Vorgang beendet; args[0] ist die Art: zeit, abbruch oder dienst."""


def abbruch_text(vorgang, e):
    """Meldung für einen beendeten Vorgang (vorgang: schon übersetzter Name)."""
    vorlagen = {
        "zeit": _("{task} timed out"),
        "abbruch": _("{task} canceled"),
        "dienst": _("{task} failed: the verification service closed the connection. "
                    "Details: journalctl -t winky"),
    }
    return vorlagen.get(e.args[0], vorlagen["dienst"]).format(task=vorgang)


def ausgabe(art, daten):
    sys.stdout.write(f"{art} {json.dumps(daten, ensure_ascii=False)}\n")
    sys.stdout.flush()


def fertig(ok, **daten):
    daten["ok"] = ok
    ausgabe("ERGEBNIS", daten)
    sys.exit(0 if ok else 1)


def aufrufer():
    if os.geteuid() != 0:
        fertig(False, fehler=_("winky-verwalten must run as root (pkexec or sudo)"))
    roh = os.environ.get("PKEXEC_UID") or os.environ.get("SUDO_UID")
    try:
        uid = int(roh)
        eintrag = pwd.getpwuid(uid)
    except (TypeError, ValueError, KeyError):
        fertig(False, fehler=_("Could not tell who is calling"))
    if uid < 1000 or uid == 65534:
        fertig(False, fehler=_("Only for regular user accounts"))
    return uid, eintrag.pw_name


# Dateien

def schreibe_atomar(pfad, daten: bytes, modus, gid=0):
    ordner = os.path.dirname(pfad)
    tmp = os.path.join(ordner, f".{os.path.basename(pfad)}.neu")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW | os.O_CLOEXEC, modus)
    try:
        os.fchown(fd, 0, gid)
        os.fchmod(fd, modus)
        os.write(fd, daten)
        os.fsync(fd)
    finally:
        os.close(fd)
    os.replace(tmp, pfad)


def sicherer_ordner(pfad, modus, gid=0):
    try:
        st = os.lstat(pfad)
        if not stat.S_ISDIR(st.st_mode) or stat.S_ISLNK(st.st_mode):
            fertig(False, fehler=_("{path} is not a folder").format(path=pfad))
    except FileNotFoundError:
        os.mkdir(pfad, modus)
    os.chown(pfad, 0, gid, follow_symlinks=False)
    os.chmod(pfad, modus)


def lese_konfig():
    try:
        with open(KONFIG, encoding="utf-8") as f:
            return f.read()
    except FileNotFoundError:
        return KONFIG_VORGABE


def konfig_wert(text, schluessel):
    for zeile in text.splitlines():
        zeile = zeile.split("#", 1)[0].strip()
        if "=" in zeile:
            k, v = (t.strip() for t in zeile.split("=", 1))
            if k == schluessel:
                return v
    return None


def setze_konfig(schluessel, wert):
    text = lese_konfig()
    zeilen, gesetzt = [], False
    for zeile in text.splitlines():
        kern = zeile.split("#", 1)[0].strip()
        if "=" in kern and kern.split("=", 1)[0].strip() == schluessel:
            zeilen.append(f"{schluessel} = {wert}")
            gesetzt = True
        else:
            zeilen.append(zeile)
    if not gesetzt:
        zeilen.append(f"{schluessel} = {wert}")
    sicherer_ordner("/etc/winky", 0o755)
    schreibe_atomar(KONFIG, ("\n".join(zeilen) + "\n").encode(), 0o644)


def vorlagen_pfad(uid):
    return f"{BASIS}/{uid}/vorlagen.bin"


def geste_pfad(uid):
    """Freigabe für sudo: ✌-Test bestanden (liest der Prüfdienst)."""
    return f"{BASIS}/{uid}/geste-ok"


def loeschen(pfad):
    try:
        os.unlink(pfad)
    except FileNotFoundError:
        pass


def lese_status(uid):
    try:
        with open(f"{STATUS_ORDNER}/{uid}.json", encoding="utf-8") as f:
            daten = json.load(f)
        return daten if isinstance(daten, dict) else {}
    except (FileNotFoundError, ValueError):
        return {}


def schreibe_status(uid, daten):
    sicherer_ordner(STATUS_ORDNER, 0o755)
    schreibe_atomar(f"{STATUS_ORDNER}/{uid}.json", json.dumps(daten).encode(), 0o644)


def aktuelle_schwelle():
    try:
        return float(konfig_wert(lese_konfig(), "schwelle") or 0)
    except ValueError:
        return 0.0


# Prüfdienst

def verbinde(op, uid, dauer):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET)
    try:
        s.connect(SOCKET)
    except OSError:
        fertig(False, fehler=_("The verification service is not running (winky.socket)"))
    cred = s.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i"))
    if struct.unpack("3i", cred)[1] != 0:
        fertig(False, fehler=_("The verification service does not belong to root"))
    s.send(struct.pack("IIII", MAGIC, op, uid, dauer))
    return s


def zeichne_rahmen(rgb, w, h, rahmen, farbe):
    x1, y1, x2, y2 = (max(0, min(int(v), grenze - 1)) for v, grenze in
                      zip(rahmen, (w, h, w, h)))
    for dicke in range(2):
        for y in (y1 + dicke, y2 - dicke):
            a = (y * w + x1) * 3
            rgb[a:a + (x2 - x1 + 1) * 3] = bytes(farbe) * (x2 - x1 + 1)
        for y in range(y1, y2 + 1):
            for x in (x1 + dicke, x2 - dicke):
                a = (y * w + x) * 3
                rgb[a:a + 3] = bytes(farbe)


def strom(s):
    """Leitet Stand und Vorschau an die Oberfläche weiter. Liefert (antwort, vektoren)."""
    rahmen, gut = None, False
    vektoren = None
    fehlertext = None
    letzter = {}
    stdin_offen = True
    while True:
        lesbar = [s] + ([sys.stdin] if stdin_offen else [])
        bereit = select.select(lesbar, [], [], 70)[0]
        if not bereit:
            raise Abbruch("zeit")
        if sys.stdin in bereit:
            if not os.read(sys.stdin.fileno(), 4096):
                stdin_offen = False
                s.close()
                raise Abbruch("abbruch")
        if s not in bereit:
            continue
        try:
            msg = s.recv(262144)
        except OSError:
            msg = b""
        if not msg:
            raise Abbruch("dienst")
        art, inhalt = chr(msg[0]), msg[1:]
        if art == "S":
            st = json.loads(inhalt.decode())
            letzter = st
            rahmen, gut = st.get("rahmen"), st.get("grund") == "ok"
            fehlertext = st.get("fehler") or fehlertext
            ausgabe("STATUS", st)
        elif art == "B" and len(inhalt) >= 4:
            w, h = struct.unpack("HH", inhalt[:4])
            grau = inhalt[4:]
            if len(grau) != w * h:
                continue
            rgb = bytearray(w * h * 3)
            rgb[0::3] = grau
            rgb[1::3] = grau
            rgb[2::3] = grau
            if rahmen:
                zeichne_rahmen(rgb, w, h, rahmen, (60, 220, 90) if gut else (245, 170, 30))
            sys.stdout.buffer.write(f"BILD {w} {h} {len(rgb)}\n".encode() + bytes(rgb))
            sys.stdout.buffer.flush()
        elif art == "V":
            vektoren = inhalt
        elif art == "E" and len(inhalt) == 16:
            _, status, wert, dauer = struct.unpack("IIfI", inhalt)
            antwort = {"status": STATUS_TEXT.get(status, "fehler"), "wert": round(wert, 3),
                       "dauer_ms": dauer}
            if fehlertext:
                antwort["fehler"] = fehlertext
            if "gesicht_erkannt" in letzter:
                antwort["gesicht_erkannt"] = bool(letzter.get("gesicht_erkannt"))
            return antwort, vektoren


def pruefe_vektoren(roh):
    if roh is None or len(roh) < 72:
        fertig(False, fehler=_("No face data received from the verification service"))
    anzahl, dim = struct.unpack("II", roh[:8])
    modell = roh[8:72]
    floats = roh[72:]
    if modell != MODELL_SHA or dim != MODELL_DIM or not 8 <= anzahl <= 64 or \
            len(floats) != anzahl * dim * 4:
        fertig(False, fehler=_("The face data from the verification service is invalid"))
    werte = struct.unpack(f"{anzahl * dim}f", floats)
    for i in range(anzahl):
        v = werte[i * dim:(i + 1) * dim]
        if not all(math.isfinite(x) for x in v) or abs(math.sqrt(sum(x * x for x in v)) - 1) > 1e-3:
            fertig(False, fehler=_("The face data from the verification service is invalid"))
    return anzahl, dim, floats


# Befehle

def befehl_einlernen(uid, _name):
    s = verbinde(OP_EINLERNEN, uid, 25)
    try:
        antwort, vektoren = strom(s)
    except Abbruch as e:
        fertig(False, fehler=abbruch_text(_("Recording your face"), e), abgebrochen=True)
    if antwort["status"] != "ok":
        hinweis = {"kein_gesicht": _("Too few usable images. Please look straight into the "
                                     "camera and move your head only slightly.")}
        fertig(False, fehler=hinweis.get(antwort["status"]) or antwort.get("fehler") or
               _("Recording your face failed. Details: journalctl -t winky"))
    anzahl, dim, floats = pruefe_vektoren(vektoren)
    gid = grp.getgrnam(GRUPPE).gr_gid
    sicherer_ordner(BASIS, 0o755)
    sicherer_ordner(f"{BASIS}/{uid}", 0o750, gid)
    kopf = b"WNKV" + struct.pack("III", 1, dim, anzahl) + MODELL_SHA + struct.pack("q", int(time.time()))
    schreibe_atomar(vorlagen_pfad(uid), kopf + floats, 0o640, gid)
    loeschen(geste_pfad(uid))  # neue Vorlagen: ✌-Test bitte neu
    schreibe_status(uid, {"vorlagen": anzahl, "eingelernt": int(time.time())})
    fertig(True, vorlagen=anzahl)


def befehl_testen(uid, _name):
    s = verbinde(OP_TESTEN, uid, 15)
    try:
        antwort = strom(s)[0]
    except Abbruch as e:
        fertig(False, fehler=abbruch_text(_("Test"), e), abgebrochen=True)
    if antwort["status"] == "fehler" and not antwort.get("fehler"):
        antwort["fehler"] = _("Test failed. Details: journalctl -t winky")
    if antwort["status"] == "treffer":
        status = lese_status(uid)
        status.update(test_ok=int(time.time()), test_wert=antwort["wert"])
        schreibe_status(uid, status)
    fertig(antwort["status"] == "treffer", **antwort)


def countdown(sekunden):
    """Zeit nach der Passworteingabe, um aus dem Bild zu gehen. Abbruch über die
    geschlossene Eingabe wie beim Kamerastrom."""
    for rest in range(sekunden, 0, -1):
        ausgabe("STATUS", {"modus": "countdown", "rest": rest})
        bereit = select.select([sys.stdin], [], [], 1)[0]
        if bereit and not os.read(sys.stdin.fileno(), 4096):
            fertig(False, fehler=abbruch_text(_("Second-person check"), Abbruch("abbruch")),
                   abgebrochen=True)


def befehl_gegenprobe(uid, _name):
    """Eine andere Person darf nicht erkannt werden und soll deutlich unter der Schwelle bleiben."""
    if not os.path.exists(vorlagen_pfad(uid)):
        fertig(False, fehler=_("Record your own face first"))
    countdown(GEGENPROBE_COUNTDOWN)
    s = verbinde(OP_TESTEN, uid, 10)
    try:
        antwort = strom(s)[0]
    except Abbruch as e:
        fertig(False, fehler=abbruch_text(_("Second-person check"), e), abgebrochen=True)
    if antwort["status"] in ("kein_gesicht",):
        fertig(False, fehler=_("No face seen. The other person should look straight into the "
                               "camera."), **antwort)
    if antwort["status"] not in ("treffer", "kein_treffer"):
        fertig(False, fehler=antwort.get("fehler") or _("Check with a second person failed"),
               **antwort)
    schwelle = aktuelle_schwelle()
    wert = antwort["wert"]
    erkannt = antwort["status"] == "treffer"
    zu_nah = wert >= schwelle - GEGENPROBE_ABSTAND
    status = lese_status(uid)
    status.update(gegenprobe_zeit=int(time.time()), gegenprobe_wert=wert,
                  gegenprobe_ok=not erkannt and not zu_nah)
    schreibe_status(uid, status)
    if erkannt:
        fertig(False, fehler=_("The other person was recognized as you. The threshold needs "
                               "to be higher."), **antwort)
    if zu_nah:
        fertig(False, fehler=_("The other person reached {value}, close to the threshold of "
                               "{threshold}. Please raise the threshold.").format(
                                   value=f"{wert:.2f}", threshold=f"{schwelle:.2f}"), **antwort)
    fertig(True, **antwort)


def befehl_geste_testen(uid, _name):
    """Gesicht und ✌ wie bei sudo, aber mit Vorschau und mehr Zeit. Gelingt es, gibt das
    die sudo-Bestätigung für diese Person frei (Datei geste-ok)."""
    if not os.path.exists(vorlagen_pfad(uid)):
        fertig(False, fehler=_("Record your own face first"))
    s = verbinde(OP_GESTE_TESTEN, uid, 12)
    try:
        antwort = strom(s)[0]
    except Abbruch as e:
        fertig(False, fehler=abbruch_text(_("Test"), e), abgebrochen=True)
    if antwort["status"] == "treffer":
        gid = grp.getgrnam(GRUPPE).gr_gid
        jetzt = int(time.time())
        schreibe_atomar(geste_pfad(uid), f"{jetzt}\n".encode(), 0o640, gid)
        status = lese_status(uid)
        status.update(geste_ok=jetzt)
        schreibe_status(uid, status)
        fertig(True, **antwort)
    if antwort["status"] == "kein_treffer" and antwort.get("gesicht_erkannt"):
        antwort["fehler"] = _("Your face was recognized, but the ✌ sign wasn't. Show your "
                              "index and middle finger as a V, palm facing the camera, next to "
                              "your face.")
    elif antwort["status"] in ("kein_treffer", "kein_gesicht") and not antwort.get("fehler"):
        antwort["fehler"] = _("Your face was not recognized. Please look straight into the "
                              "camera.")
    elif not antwort.get("fehler"):
        antwort["fehler"] = _("Test failed. Details: journalctl -t winky")
    fertig(False, **antwort)


def kamerasuche(uid):
    s = verbinde(OP_KAMERAS, uid, 0)
    liste = None
    while True:
        bereit = select.select([s], [], [], 30)[0]
        if not bereit:
            fertig(False, fehler=_("The camera search is taking too long"))
        msg = s.recv(262144)
        if not msg:
            break
        if chr(msg[0]) == "S":
            try:
                liste = json.loads(msg[1:].decode()).get("kameras")
            except ValueError:
                pass
        elif chr(msg[0]) == "E":
            break
    if not isinstance(liste, list):
        fertig(False, fehler=_("The camera search failed"))
    return [k for k in liste if isinstance(k, dict) and isinstance(k.get("pfad"), str)]


def beste_kamera(liste):
    nutzbar = [k for k in liste if not k.get("fehler")]
    nutzbar.sort(key=lambda k: (k.get("hell", 0) >= 10, bool(k.get("blinkt")), k.get("hell", 0)),
                 reverse=True)
    return nutzbar[0] if nutzbar else None


def befehl_kameras(uid, _name):
    liste = kamerasuche(uid)
    beste = beste_kamera(liste)
    fertig(True, kameras=liste, empfohlen=beste["pfad"] if beste else None)


def befehl_kamera(uid, _name, wahl=None):
    liste = kamerasuche(uid)
    if wahl == "auto":
        kamera = beste_kamera(liste)
    else:
        kamera = next((k for k in liste if wahl in (k.get("pfad"), k.get("geraet"))), None)
    if kamera is None:
        fertig(False, fehler=_("No suitable IR camera found. Winky looks for cameras with a "
                               "grayscale image (IR)."), kameras=liste)
    if kamera.get("fehler"):
        fertig(False, fehler=_("The camera can't be opened: {error}").format(
            error=kamera["fehler"]))
    pfad = kamera["pfad"]
    if not pfad.startswith("/dev/") or ".." in pfad or any(c in pfad for c in "\n\r#= "):
        fertig(False, fehler=_("Invalid camera path"))
    setze_konfig("kamera", pfad)
    setze_konfig("blinkpruefung", "ja" if kamera.get("blinkt") else "nein")
    hinweis = None
    if kamera.get("hell", 0) < 10:
        hinweis = _("The IR image stays dark. On some laptops the IR emitter has to be "
                    "switched on first (for example with linux-enable-ir-emitter).")
    fertig(True, kamera=kamera, hinweis=hinweis)


def befehl_entfernen(uid, _name):
    for pfad in (vorlagen_pfad(uid), geste_pfad(uid), f"{STATUS_ORDNER}/{uid}.json"):
        try:
            os.unlink(pfad)
        except FileNotFoundError:
            pass
    try:
        os.rmdir(f"{BASIS}/{uid}")
    except OSError:
        pass
    fertig(True)


def befehl_schwelle(_uid, _name, wert=None):
    try:
        w = round(float(wert), 2)
    except (TypeError, ValueError):
        fertig(False, fehler=_("The threshold is missing or not a number"))
    if not 0.40 <= w <= 0.95:
        # Zahlen stehen im Text, damit jede Sprache ihr Dezimalzeichen nimmt
        fertig(False, fehler=_("The threshold must be between 0.40 and 0.95"))
    setze_konfig("schwelle", f"{w:.2f}")
    fertig(True, schwelle=w)


def pam_aktiv():
    try:
        with open(COMMON_AUTH, encoding="utf-8") as f:
            return any("pam_winky.so" in z and not z.lstrip().startswith("#") for z in f)
    except FileNotFoundError:
        return False


def befehl_aktivieren(uid, _name):
    if not konfig_wert(lese_konfig(), "kamera"):
        fertig(False, fehler=_("Set up the camera first"))
    if not os.path.exists(vorlagen_pfad(uid)):
        fertig(False, fehler=_("Record your face first"))
    schwelle = aktuelle_schwelle()
    if schwelle <= 0:
        fertig(False, fehler=_("Set a threshold first"))
    status = lese_status(uid)
    if status.get("test_ok", 0) < status.get("eingelernt", 0) or not status.get("test_ok"):
        fertig(False, fehler=_("Try out the recognition successfully first"))
    if "gegenprobe_wert" in status and status["gegenprobe_wert"] >= schwelle - GEGENPROBE_ABSTAND:
        fertig(False, fehler=_("The check with a second person came too close to the threshold. "
                               "Raise the threshold and repeat the check."))
    subprocess.run(["systemctl", "enable", "--now", "winky.socket"], check=False,
                   capture_output=True)
    sicherer_ordner(SICHERUNG, 0o700)
    with open(COMMON_AUTH, "rb") as f:
        schreibe_atomar(f"{SICHERUNG}/common-auth.{time.strftime('%Y%m%d-%H%M%S')}", f.read(), 0o600)
    r = subprocess.run(["pam-auth-update", "--enable", "winky"], capture_output=True, text=True,
                       env={"PATH": "/usr/sbin:/usr/bin:/sbin:/bin",
                            "DEBIAN_FRONTEND": "noninteractive"})
    if r.returncode != 0 or not pam_aktiv():
        fertig(False, fehler=_("pam-auth-update did not add the profile"),
               ausgabe=(r.stdout + r.stderr)[-500:])
    fertig(True)


def keepassxc_mit_geste():
    """KeePassXC nur mit Gesicht und ✌ (Vorgabe, wenn der Schlüssel fehlt)."""
    return konfig_wert(lese_konfig(), "keepassxc_geste") != "nein"


def befehl_keepassxc(uid, _name, wahl=None):
    """Polkit-Regel für das Schnellentsperren von KeePassXC ein- oder ausschalten;
    geste-an/geste-aus: zusätzlich das Handzeichen ✌ verlangen (Vorgabe) oder nicht."""
    if wahl == "geste-an":
        setze_konfig("keepassxc_geste", "ja")
        fertig(True)
    if wahl == "geste-aus":
        setze_konfig("keepassxc_geste", "nein")
        fertig(True, hinweis=_("KeePassXC will now open with just your face"))
    if wahl == "an":
        if not konfig_wert(lese_konfig(), "kamera"):
            fertig(False, fehler=_("Set up the camera first"))
        status = lese_status(uid)
        if not os.path.exists(vorlagen_pfad(uid)):
            fertig(False, fehler=_("Record your face first"))
        if status.get("test_ok", 0) < status.get("eingelernt", 0) or not status.get("test_ok"):
            fertig(False, fehler=_("Try out the recognition successfully first"))
        if keepassxc_mit_geste() and not os.path.exists(geste_pfad(uid)):
            fertig(False, fehler=_("Test your face and ✌ first"))
        with open(KEEPASSXC_REGEL_VORLAGE, "rb") as f:
            regel = f.read()
        ordner = os.path.dirname(KEEPASSXC_REGEL)
        if not os.path.isdir(ordner) or os.path.islink(ordner):
            fertig(False, fehler=_("The polkit rules folder is missing"))
        setze_konfig("keepassxc", "ja")
        schreibe_atomar(KEEPASSXC_REGEL, regel, 0o644)
        subprocess.run(["systemctl", "enable", "--now", "winky-polkit.socket"], check=False,
                       capture_output=True)
        fertig(True)
    if wahl == "aus":
        try:
            os.unlink(KEEPASSXC_REGEL)
        except FileNotFoundError:
            pass
        setze_konfig("keepassxc", "nein")
        polkit_zugang_anpassen()
        fertig(True)
    fertig(False, fehler=_("Usage: {usage}").format(usage="keepassxc an|aus|geste-an|geste-aus"))


def admin_aktionen():
    """Polkit-Aktionen, die ein Administratorpasswort verlangen (implicit active auth_admin*)."""
    r = subprocess.run(["pkaction", "--verbose"], capture_output=True, text=True,
                       env={"PATH": "/usr/bin:/bin", "LANG": "C"})
    aktionen, aktuell = set(), None
    for zeile in r.stdout.splitlines():
        if zeile and not zeile[0].isspace() and zeile.endswith(":"):
            aktuell = zeile[:-1]
        elif aktuell and zeile.strip().startswith("implicit active:") and \
                zeile.split(":", 1)[1].strip().startswith("auth_admin"):
            aktionen.add(aktuell)
    return aktionen


def freigaben_gruppen():
    wert = konfig_wert(lese_konfig(), "freigaben") or ""
    return [g for g in wert.split(",") if g in FREIGABEN or g == "system"]


def schreibe_freigaben_regel(gruppen):
    """Polkit-Regel aus den gewählten Gruppen erzeugen; nur Aktionen mit Administratorpasswort,
    nur für Administratoren in einer lokalen, aktiven Sitzung."""
    admin = admin_aktionen()
    bekannt = set().union(*FREIGABEN.values())
    aktionen = set()
    for g in gruppen:
        aktionen |= (admin - bekannt) if g == "system" else (FREIGABEN[g] & admin)
    aktionen = sorted(a for a in aktionen if not a.startswith(FREIGABEN_NIE))
    if not gruppen:
        loeschen(FREIGABEN_REGEL)
        return
    liste = ",\n".join(f'        "{a}": true' for a in aktionen)
    regel = f"""// Winky: Administrator-Dialoge mit Gesicht und ✌ ({", ".join(gruppen)}).
// Erzeugt von winky-verwalten, Änderungen gehen beim nächsten Umschalten verloren.
polkit.addRule(function(action, subject) {{
    var aktionen = {{
{liste}
    }};
    if (aktionen[action.id] !== true || !subject.local || !subject.active ||
            !(subject.isInGroup("sudo") || subject.isInGroup("admin"))) {{
        return polkit.Result.NOT_HANDLED;
    }}
    var detail = "";
    if (action.id == "org.freedesktop.policykit.exec") {{
        detail = String(action.lookup("command_line") || "");
    }}
    try {{
        polkit.spawn(["/usr/libexec/winky/winky-polkit-pruefung", subject.user, action.id, detail]);
        return polkit.Result.YES;
    }} catch (fehler) {{
        return polkit.Result.NOT_HANDLED;
    }}
}});
"""
    ordner = os.path.dirname(FREIGABEN_REGEL)
    if not os.path.isdir(ordner) or os.path.islink(ordner):
        fertig(False, fehler=_("The polkit rules folder is missing"))
    schreibe_atomar(FREIGABEN_REGEL, regel.encode(), 0o644)


def polkit_zugang_anpassen():
    an = bool(freigaben_gruppen()) or os.path.exists(KEEPASSXC_REGEL)
    subprocess.run(["systemctl", "enable" if an else "disable", "--now", "winky-polkit.socket"],
                   check=False, capture_output=True)


def befehl_freigabe(uid, _name, gruppe, an):
    """Gruppe von Administrator-Dialogen mit Gesicht und ✌ freigeben oder zurück aufs Passwort."""
    if gruppe not in FREIGABEN and gruppe != "system":
        fertig(False, fehler=_("Unknown group: {group}").format(group=gruppe))
    gruppen = freigaben_gruppen()
    if an:
        if not pam_aktiv():
            fertig(False, fehler=_("Turn on face unlock for the lock screen first"))
        if not os.path.exists(geste_pfad(uid)):
            fertig(False, fehler=_("Test your face and ✌ successfully first"))
        gruppen = [g for g in list(FREIGABEN) + ["system"] if g in gruppen or g == gruppe]
    else:
        gruppen = [g for g in gruppen if g != gruppe]
    setze_konfig("freigaben", ",".join(gruppen))
    schreibe_freigaben_regel(gruppen)
    polkit_zugang_anpassen()
    fertig(True)


def befehl_sudo(uid, _name, wahl=None):
    """sudo mit Gesicht und ✌: Schalter in winky.conf (Prüfdienst) und /etc/winky/sudo-ein (PAM).
    Nur bei aktiver Gesichtsentsperrung und bestandenem ✌-Test; jede Person braucht ihren eigenen."""
    if wahl == "an":
        if not pam_aktiv():
            fertig(False, fehler=_("Turn on face unlock for the lock screen first"))
        if not os.path.exists(geste_pfad(uid)):
            fertig(False, fehler=_("Test your face and ✌ successfully first"))
        setze_konfig("sudo", "ja")
        sicherer_ordner("/etc/winky", 0o755)
        schreibe_atomar(SUDO_SCHALTER, b"sudo mit Gesicht und Handzeichen bestaetigen\n", 0o644)
        fertig(True)
    if wahl == "aus":
        loeschen(SUDO_SCHALTER)
        setze_konfig("sudo", "nein")
        fertig(True)
    fertig(False, fehler=_("Usage: {usage}").format(usage="sudo an|aus"))


def befehl_deaktivieren(_uid, _name):
    # sudo per ✌ hängt am Profil: mit ausschalten
    loeschen(SUDO_SCHALTER)
    if konfig_wert(lese_konfig(), "sudo") == "ja":
        setze_konfig("sudo", "nein")
    r = subprocess.run(["pam-auth-update", "--disable", "winky"], capture_output=True, text=True,
                       env={"PATH": "/usr/sbin:/usr/bin:/sbin:/bin",
                            "DEBIAN_FRONTEND": "noninteractive"})
    if r.returncode != 0 or pam_aktiv():
        fertig(False, fehler=_("The profile could not be removed"),
               ausgabe=(r.stdout + r.stderr)[-500:])
    fertig(True)


def befehl_pausieren(_uid, _name):
    sicherer_ordner("/etc/winky", 0o755)
    schreibe_atomar(NOTSCHALTER, b"Gesichtsentsperrung pausiert\n", 0o644)
    fertig(True)


def befehl_fortsetzen(_uid, _name):
    try:
        os.unlink(NOTSCHALTER)
    except FileNotFoundError:
        pass
    fertig(True)


def befehl_status(uid, name):
    status = lese_status(uid)
    socket_aktiv = subprocess.run(["systemctl", "is-active", "--quiet", "winky.socket"]).returncode == 0
    fertig(True, benutzer=name, eingelernt=os.path.exists(vorlagen_pfad(uid)),
           vorlagen=status.get("vorlagen"), schwelle=konfig_wert(lese_konfig(), "schwelle"),
           kamera=konfig_wert(lese_konfig(), "kamera"), test_ok=status.get("test_ok"),
           keepassxc=os.path.exists(KEEPASSXC_REGEL), keepassxc_geste=keepassxc_mit_geste(),
           sudo=os.path.exists(SUDO_SCHALTER), freigaben=freigaben_gruppen(),
           geste_ok=os.path.exists(geste_pfad(uid)),
           gegenprobe_ok=status.get("gegenprobe_ok"),
           aktiv=pam_aktiv(), pausiert=os.path.exists(NOTSCHALTER), dienst=socket_aktiv)


BEFEHLE = {
    "status": befehl_status, "einlernen": befehl_einlernen, "testen": befehl_testen,
    "gegenprobe": befehl_gegenprobe, "kameras": befehl_kameras, "kamera": befehl_kamera,
    "entfernen": befehl_entfernen, "schwelle": befehl_schwelle,
    "aktivieren": befehl_aktivieren, "deaktivieren": befehl_deaktivieren,
    "pausieren": befehl_pausieren, "fortsetzen": befehl_fortsetzen,
    "keepassxc": befehl_keepassxc, "geste-testen": befehl_geste_testen, "sudo": befehl_sudo,
    "freigabe-an": None, "freigabe-aus": None,
}


def main(argv):
    os.umask(0o022)
    # Nach Paket-Updates (postinst, root ohne pkexec): Freigaben-Regel neu erzeugen
    if argv[1:] == ["regeln-erneuern"] and os.getuid() == 0 and "PKEXEC_UID" not in os.environ \
            and "SUDO_UID" not in os.environ:
        if os.path.exists(FREIGABEN_REGEL):
            schreibe_freigaben_regel(freigaben_gruppen())
        sys.exit(0)
    mit_wert = {"schwelle", "kamera", "keepassxc", "sudo", "freigabe-an", "freigabe-aus"}
    if len(argv) < 2 or argv[1] not in BEFEHLE or (argv[1] in mit_wert) != (len(argv) == 3) \
            or len(argv) > 3:
        fertig(False, fehler=_("Usage: winky-verwalten {commands} [VALUE]").format(
            commands="|".join(BEFEHLE)))
    if os.path.basename(argv[0]) == "winky-gesicht" and argv[1] not in GESICHT_BEFEHLE:
        fertig(False, fehler=_("This needs the administrator password (winky-verwalten)"))
    uid, name = aufrufer()
    if argv[1] == "schwelle":
        befehl_schwelle(uid, name, argv[2])
    if argv[1] == "kamera":
        befehl_kamera(uid, name, argv[2])
    if argv[1] == "keepassxc":
        befehl_keepassxc(uid, name, argv[2])
    if argv[1] == "sudo":
        befehl_sudo(uid, name, argv[2])
    if argv[1] in ("freigabe-an", "freigabe-aus"):
        befehl_freigabe(uid, name, argv[2], argv[1] == "freigabe-an")
    BEFEHLE[argv[1]](uid, name)


if __name__ == "__main__":
    main(sys.argv)
