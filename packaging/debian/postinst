#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
    systemd-sysusers /usr/lib/sysusers.d/winky.conf
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/winky.conf
    # Keine dpkg-Konfigurationsdatei, da App und winky-verwalten sie schreiben (sonst Rückfrage
    # mit Überschreibgefahr bei jeder neuen Vorgabe). Ältere Fassungen hatten sie als solche;
    # dpkg lässt sie dann beim Aktualisieren stehen.
    if [ ! -e /etc/winky/winky.conf ]; then
        install -D -m0644 /usr/share/winky/winky.conf /etc/winky/winky.conf
    fi
    # Gesichtsdaten ohne Kennung WNKV stammen von einem älteren Erkennungsmodell und passen
    # nicht mehr: löschen, bis zur Neuaufnahme in der App gilt das Passwort.
    alt=0
    for d in /var/lib/winky/[0-9]*; do
        [ -d "$d" ] && [ ! -L "$d" ] && [ -f "$d/vorlagen.bin" ] || continue
        if [ "$(head -c 4 "$d/vorlagen.bin")" != "WNKV" ]; then
            rm -f "$d/vorlagen.bin" "$d/geste-ok" "/var/lib/winky/status/${d##*/}.json"
            alt=1
        fi
    done
    if [ "$alt" = 1 ]; then
        echo "Winky: neues Erkennungsmodell. Bitte in der App das Gesicht neu aufnehmen." >&2
    fi
    # Benutzerordner der Vorlagen gehören der Gruppe des Prüfdienstes
    for d in /var/lib/winky/[0-9]*; do
        [ -d "$d" ] && [ ! -L "$d" ] && chown -R root:_winky "$d" && chmod 0750 "$d"
    done
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable --now winky.socket winky-schluessel.socket >/dev/null 2>&1 || true
    # "Default: no": Profil bleibt aus, bis die App es einschaltet; ein aktives wird erneuert
    pam-auth-update --package
    # Polkit-Gruppen aus 0.10.0 auf den Dialog-Schalter umstellen, alte Regel löschen
    /usr/libexec/winky/winky-verwalten migrieren >/dev/null 2>&1 || true
fi
exit 0
