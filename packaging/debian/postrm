#!/bin/sh
set -e
if [ "$1" = "remove" ]; then
    # Die Gesichtsdaten gehören zum Programm und gehen mit. Die Software-Verwaltung
    # kennt kein purge, ein Deinstallieren dort soll trotzdem keine Gesichter
    # zurücklassen. Es bleiben die Einstellungsdatei und die PAM-Sicherungen.
    find /var/lib/winky -mindepth 1 -maxdepth 1 ! -name sicherung -exec rm -rf {} + 2>/dev/null || true
    rm -rf /run/winky
    # sudo mit ✌ muss nach einer Neuinstallation ausdrücklich wieder eingeschaltet werden
    rm -f /etc/winky/sudo-ein
fi
if [ "$1" = "purge" ]; then
    rm -rf /var/lib/winky /run/winky
    rm -f /etc/winky/disabled /etc/winky/sudo-ein
    rmdir /etc/winky 2>/dev/null || true
fi
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
fi
exit 0
