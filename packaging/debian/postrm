#!/bin/sh
set -e
if [ "$1" = "remove" ]; then
    # Gesichtsdaten schon bei remove löschen, denn die Software-Verwaltung kennt kein purge.
    # Einstellungsdatei und PAM-Sicherungen bleiben.
    find /var/lib/winky -mindepth 1 -maxdepth 1 ! -name sicherung -exec rm -rf {} + 2>/dev/null || true
    rm -rf /run/winky
    # sudo mit ✌ muss nach einer Neuinstallation ausdrücklich wieder eingeschaltet werden
    rm -f /etc/winky/sudo-ein /etc/winky/anmeldung-ein /etc/winky/dialoge-ein \
        /etc/winky/entsperren-geste
fi
if [ "$1" = "purge" ]; then
    rm -rf /var/lib/winky /run/winky
    rm -f /etc/winky/disabled /etc/winky/sudo-ein /etc/winky/anmeldung-ein /etc/winky/dialoge-ein \
        /etc/winky/entsperren-geste \
        /etc/winky/winky.conf \
        /etc/winky/winky.conf.dpkg-old /etc/winky/winky.conf.dpkg-dist
    rmdir /etc/winky 2>/dev/null || true
fi
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
    # Infrarot-Kamera wieder wie vor Winky für den angemeldeten Benutzer freigeben
    if [ -e /etc/udev/rules.d/72-winky-ir-kamera.rules ]; then
        rm -f /etc/udev/rules.d/72-winky-ir-kamera.rules
        udevadm control --reload >/dev/null 2>&1 || true
        udevadm trigger --action=change --subsystem-match=video4linux >/dev/null 2>&1 || true
        udevadm settle --timeout=10 >/dev/null 2>&1 || true
        # Bei „change“ setzt udev die Gruppe nicht zurück
        for d in /dev/video*; do
            [ "$(stat -c %G "$d" 2>/dev/null)" = _winky ] && chgrp video "$d" || true
        done
    fi
fi
exit 0
