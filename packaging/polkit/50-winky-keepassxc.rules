// Winky: Schnellentsperren von KeePassXC (ab 2.8) per Gesicht, nur für diese eine Aktion.
// Erkannt (Exit 0): kein Passwort; sonst wirft polkit.spawn() und es bleibt beim Passwortdialog.
// Ein-/Ausschalten über die Winky-App.
polkit.addRule(function(action, subject) {
    if (action.id !== "org.keepassxc.KeePassXC.unlockDatabase") {
        return polkit.Result.NOT_HANDLED;
    }
    if (!subject.local || !subject.active) {
        return polkit.Result.NOT_HANDLED;
    }
    try {
        polkit.spawn(["/usr/libexec/winky/winky-polkit-pruefung", subject.user]);
        return polkit.Result.YES;
    } catch (fehler) {
        return polkit.Result.NOT_HANDLED;
    }
});
