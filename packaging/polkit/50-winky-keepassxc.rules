// Winky: Gesichtsentsperrung für KeePassXC
//
// Gilt ausschließlich für das Schnellentsperren von KeePassXC (ab Version 2.8,
// Aktion org.keepassxc.KeePassXC.unlockDatabase). Erkennt die IR-Kamera das
// eingelernte Gesicht des Benutzers, entfällt die Passworteingabe. Sonst bleibt
// es beim normalen Passwortdialog. Alle anderen Polkit-Aktionen bleiben
// unberührt. Ein- und ausgeschaltet über die App "Gesichtsentsperrung".
polkit.addRule(function(action, subject) {
    if (action.id !== "org.keepassxc.KeePassXC.unlockDatabase") {
        return polkit.Result.NOT_HANDLED;
    }
    if (!subject.local || !subject.active) {
        return polkit.Result.NOT_HANDLED;
    }
    try {
        polkit.spawn(["/usr/libexec/winky/winky-polkit-pruefung", subject.user]);
        return polkit.Result.YES;
    } catch (fehler) {
        return polkit.Result.NOT_HANDLED;
    }
});
